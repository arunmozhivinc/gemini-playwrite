# ======================================================
#  YouTube Kids Shorts Pipeline — Environment Variables
# ======================================================

# --- ElevenLabs TTS (required for audio narration) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# English narrator voice (recommended: Rachel = 21m00Tcm4TlvDq8ikWAM, Adam = pNInz6obpgDQGcFmaJgB)
ELEVENLABS_VOICE_EN=21m00Tcm4TlvDq8ikWAM

# Tamil narrator voice (recommended: search "Damodar" or "Tamil" in ElevenLabs Voice Library)
# To get voice IDs: GET http://localhost:3000/api/audio/voices (after setting the API key above)
ELEVENLABS_VOICE_TA=21m00Tcm4TlvDq8ikWAM

# --- YouTube Data API v3 (required for auto-upload) ---
YOUTUBE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# --- Gemini API (optional: for alternate story generation) ---
GEMINI_API_KEY=

# --- NewsAPI (optional: for live trending topic discovery) ---
# Free key from https://newsapi.org
NEWS_API_KEY=

# --- Optional: Background music for videos ---
# BACKGROUND_MUSIC_PATH=D:/workspace/gemini-playwrite/assets/bg_music.mp3

# --- Server ---
PORT=8787
