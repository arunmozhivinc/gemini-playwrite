# Server port and host
PORT=8787
HOST=0.0.0.0

# Secret Bearer / API Key (Required for authenticated endpoints)
RENDER_API_KEY=your_secure_api_key_here

# Maximum upload file size in Megabytes
MAX_FILE_MB=250

# Maximum concurrent FFmpeg jobs (Set to 1 on Render Free tier to avoid 512MB RAM OOM)
MAX_CONCURRENT_JOBS=1

# Subtitle font override (Optional: defaults to Nirmala UI on Windows and Noto Sans Tamil on Linux)
# SUBTITLE_FONT=Noto Sans Tamil
